# OpenShift target
ATLAS_NAMESPACE=user-itigges
# This namespace is Kueue-managed. `default` currently has no GPU quota;
# `unreserved` is the queue used by existing GPU workloads in this namespace.
ATLAS_KUEUE_QUEUE=unreserved

# Images. Non-llama services can use published ATLAS images. The llama image is
# built in-cluster for Hopper by scripts/openshift/build-llama-hopper.sh.
ATLAS_IMAGE_OWNER=itigges22
ATLAS_IMAGE_TAG=latest
ATLAS_LLAMA_IMAGE=atlas-llama-hopper
ATLAS_LLAMA_IMAGE_TAG=h200
ATLAS_CUDA_ARCH=90
ATLAS_GPU_NODE_SELECTOR_KEY=node.kubernetes.io/instance-type
ATLAS_GPU_NODE_SELECTOR_VALUE=gx3d-160x1792x8h200
ATLAS_GPU_TOLERATION_KEY=nvidia.com/gpu
ATLAS_GPU_TOLERATION_VALUE=h200
ATLAS_GPU_TOLERATION_EFFECT=NoSchedule

# Model PVC and active model. The PVC must already contain the GGUF file.
ATLAS_MODEL_PVC=atlas-models
ATLAS_MODELS_STORAGE=100Gi
ATLAS_MODEL_FILE=Qwen3.5-9B-Q6_K.gguf
ATLAS_MAIN_MODEL=Qwen3.5-9B-Q6_K.gguf
ATLAS_MODEL_URL=https://huggingface.co/unsloth/Qwen3.5-9B-GGUF/resolve/3885219b6810b007914f3a7950a8d1b469d598a5/Qwen3.5-9B-Q6_K.gguf
ATLAS_MODEL_SHA256=91898433cf5ce0a8f45516a4cc3e9343b6e01d052d01f684309098c66a326c59

# Runtime sizing. H200 has headroom, but keep smoke conservative first.
ATLAS_CONTEXT_LENGTH=131072
# 5 slots with 4 concurrent bench tasks: one slot stays free so lens
# embedding calls never starve behind long generations (the 2026-07-11
# routed run zeroed 95% of candidate energies exactly this way).
ATLAS_PARALLEL_SLOTS=5
ATLAS_KV_TYPE_K=f16
ATLAS_KV_TYPE_V=f16
ATLAS_BATCH=1024
ATLAS_UBATCH=1024

# Service resources.
ATLAS_LLAMA_CPU_REQUEST=8
ATLAS_LLAMA_CPU_LIMIT=16
ATLAS_LLAMA_MEMORY_REQUEST=32Gi
ATLAS_LLAMA_MEMORY_LIMIT=64Gi
ATLAS_SERVICE_CPU_REQUEST=500m
ATLAS_SERVICE_CPU_LIMIT=2
ATLAS_SERVICE_MEMORY_REQUEST=1Gi
ATLAS_SERVICE_MEMORY_LIMIT=4Gi

# PVC sizes for ATLAS-owned state.
ATLAS_WORKSPACE_STORAGE=20Gi
ATLAS_LENS_PROJECTS_STORAGE=20Gi
ATLAS_LENS_STATE_STORAGE=2Gi
ATLAS_LENS_TRAINING_STORAGE=10Gi
ATLAS_RESULTS_STORAGE=20Gi

# Local port-forward ports for benchmark scripts.
ATLAS_LOCAL_LLAMA_PORT=18080
ATLAS_LOCAL_LENS_PORT=18099
ATLAS_LOCAL_PROXY_PORT=18090

# Matrix format:
#   label|model_filename|model_name|notes
# The script patches one model at a time and runs baseline+routed pairs.
ATLAS_BENCH_MODELS="qwen9b|Qwen3.5-9B-Q6_K.gguf|Qwen3.5-9B-Q6_K|primary V3.1 target"
# Example once Gemma is present in ATLAS_MODEL_PVC:
# ATLAS_BENCH_MODELS="qwen9b|Qwen3.5-9B-Q6_K.gguf|Qwen3.5-9B-Q6_K|primary V3.1 target;gemma4|gemma-4-coding.gguf|gemma-4-coding|Gemma smoke"
ATLAS_LLAMA_THREADS=8

# MTP self-speculation (needs the MTP-variant GGUF; set none to disable).
ATLAS_LLAMA_SPEC_TYPE=draft-mtp
ATLAS_LLAMA_SPEC_DRAFT_MAX=2
